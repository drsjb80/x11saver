"""x11saver runner. Usage: ./x11saver <plugin> [--mouse-threshold PIXELS]

A plugin is a module in plugins/ that defines:
    init(screen, size)   - called once after the display is set up
    render(screen, dt)   - called every frame; dt is seconds since last frame
    shutdown()           - called once before exit
Optional:
    FPS = <n>            - frame rate (default 30)
"""
import argparse
import importlib
import math
import os
import subprocess
import sys
import time

import pygame

# Resolve symlinks so plugins/ is found next to the real script, even when
# this file is launched through a symlink on PATH.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

GRACE_MS = 1000   # ignore input for this long after start (avoids spurious events)
DEFAULT_FPS = 30   # a plugin can set FPS = <n> at module level to override

# Lock commands per desktop, keyed by a value of XDG_CURRENT_DESKTOP.
LOCK_COMMANDS = {
    "X-Cinnamon": [["cinnamon-screensaver-command", "--lock"]],
    "Cinnamon":   [["cinnamon-screensaver-command", "--lock"]],
    "MATE":       [["mate-screensaver-command", "--lock"]],
    "XFCE":       [["xflock4"]],
    "GNOME":      [["loginctl", "lock-session"]],
    "KDE":        [["loginctl", "lock-session"]],
}
FALLBACK_LOCK = [["loginctl", "lock-session"]]


def lock_session():
    """Lock the desktop session using the command for the current desktop."""
    desktops = os.environ.get("XDG_CURRENT_DESKTOP", "").split(":")
    candidates = []
    for name in desktops:
        candidates += LOCK_COMMANDS.get(name, [])
    candidates += FALLBACK_LOCK

    for cmd in candidates:
        try:
            if subprocess.run(cmd).returncode == 0:
                return True
        except FileNotFoundError:
            continue
    print("warning: could not lock the session; no working lock command found",
          file=sys.stderr)
    return False


def normalize_plugin_name(name):
    """Accept "thematrix", "plugins/thematrix" or "plugins/thematrix.py"."""
    return os.path.splitext(os.path.basename(name))[0]


def should_exit(event_type, pos, baseline, threshold):
    """Decide whether an input event should end the screensaver.

    baseline is the pointer position when the grace period ended, or None
    while still in the grace period (input is ignored then).
    """
    if baseline is None:
        return False
    if event_type in (pygame.KEYDOWN, pygame.MOUSEBUTTONDOWN):
        return True
    if event_type == pygame.MOUSEMOTION:
        return math.hypot(pos[0] - baseline[0], pos[1] - baseline[1]) > threshold
    return False


def main(plugin_name, mouse_threshold=0.0):
    plugin_name = normalize_plugin_name(plugin_name)

    pygame.init()
    info = pygame.display.Info()
    size = (info.current_w, info.current_h)
    screen = pygame.display.set_mode(size, pygame.FULLSCREEN | pygame.NOFRAME)
    pygame.mouse.set_visible(False)
    clock = pygame.time.Clock()

    plugin = importlib.import_module(f"plugins.{plugin_name}")
    plugin.init(screen, size)

    start = pygame.time.get_ticks()
    baseline = None   # pointer position once the grace period ends
    while True:
        # Decide grace once per frame, so baseline is always set before any
        # event is judged against it.
        if baseline is None and pygame.time.get_ticks() - start >= GRACE_MS:
            baseline = pygame.mouse.get_pos()

        for event in pygame.event.get():
            if should_exit(event.type, pygame.mouse.get_pos(), baseline, mouse_threshold):
                plugin.shutdown()
                lock_session()          # lock while our window is still up
                pygame.quit()
                sys.exit()

        dt = clock.tick(getattr(plugin, "FPS", DEFAULT_FPS)) / 1000.0
        plugin.render(screen, dt)
        pygame.display.flip()


def x_idle_ms():
    """Milliseconds since the last X input, via the XScreenSaver extension."""
    from Xlib import display as xdisplay
    from Xlib.ext import screensaver

    # Reconnect each check: cheap, and survives an X server restart.
    disp = xdisplay.Display()
    try:
        return screensaver.query_info(disp.screen().root).idle
    finally:
        disp.close()


def check_once(get_idle_ms, timeout_ms, launch):
    """One daemon check: launch the saver if idle long enough.

    Returns True if the saver was launched. Errors reading idle time are
    reported and skipped, so the daemon keeps running.
    """
    try:
        idle = get_idle_ms()
    except Exception as exc:
        print(f"x11saver: idle check failed ({exc}); retrying", file=sys.stderr)
        return False
    if idle >= timeout_ms:
        launch()        # blocks until the saver exits (on input, after locking)
        return True
    return False


def daemon(plugin_name, timeout_min, interval_s, mouse_threshold):
    """Poll X idle time; when it passes timeout_min, run the saver until it exits."""
    timeout_ms = timeout_min * 60 * 1000
    cmd = [sys.executable, os.path.realpath(__file__), plugin_name,
           "--mouse-threshold", str(mouse_threshold)]

    try:
        while True:
            time.sleep(interval_s)
            check_once(x_idle_ms, timeout_ms, lambda: subprocess.run(cmd))
    except KeyboardInterrupt:
        sys.exit(0)


def parse_args(argv=None):
    parser = argparse.ArgumentParser(description="Plugin-based X11 screensaver.")
    parser.add_argument("plugin", help="plugin name, e.g. thematrix or starfield")
    parser.add_argument("-d", "--daemon", action="store_true",
                        help="run in the background and start the saver after idle time")
    parser.add_argument("--timeout", type=float, default=10.0, metavar="MINUTES",
                        help="daemon mode: idle minutes before starting (default: 10)")
    parser.add_argument("--interval", type=float, default=60.0, metavar="SECONDS",
                        help="daemon mode: how often to check idle time (default: 60)")
    parser.add_argument("--mouse-threshold", type=float, default=0.0, metavar="PIXELS",
                        help="exit on mouse motion only after the pointer moves more "
                             "than this many pixels from its starting position "
                             "(default: 0, i.e. any motion exits)")
    return parser.parse_args(argv)


if __name__ == "__main__":
    args = parse_args()
    if args.daemon:
        daemon(args.plugin, args.timeout, args.interval, args.mouse_threshold)
    else:
        main(args.plugin, args.mouse_threshold)
