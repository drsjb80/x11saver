#!/usr/bin/env python3
"""Render x11saver plugins off-screen and save looping GIFs (needs ffmpeg).

    tools/capture rain                        # writes rain.gif here
    tools/capture snow --warmup 200 -o snow.gif
    tools/capture --demos                     # regenerate all README demos
"""
import argparse
import importlib
import os
import shutil
import subprocess
import sys

os.environ["SDL_VIDEODRIVER"] = "dummy"     # no window needed
os.environ["PYGAME_HIDE_SUPPORT_PROMPT"] = "1"
REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, REPO)

import pygame  # noqa: E402  (must come after SDL_VIDEODRIVER is set)

SIM_FPS = 60        # simulate at the plugin's natural rate, sample down for the GIF

# Settings used for the README demos. thematrix is smaller because its
# constantly changing characters compress poorly.
DEMOS = {
    "thematrix": dict(size="640x360", seconds=4, fps=15, warmup=4),
    "starfield": dict(size="800x450", seconds=5, fps=20, warmup=1),
    "rain":      dict(size="800x450", seconds=5, fps=20, warmup=1),
    "snow":      dict(size="800x450", seconds=5, fps=20, warmup=200),
}


def capture(plugin_name, out, size="800x450", seconds=5.0, fps=20, warmup=2.0):
    w, h = (int(n) for n in size.split("x"))
    step = max(1, SIM_FPS // fps)
    dt = 1 / SIM_FPS

    screen = pygame.display.set_mode((w, h))
    plugin = importlib.import_module(f"plugins.{plugin_name}")
    plugin.init(screen, (w, h))

    for _ in range(int(warmup * SIM_FPS)):
        plugin.render(screen, dt)

    # Two-pass palette in one ffmpeg call gives clean colours and small files.
    ffmpeg = subprocess.Popen(
        ["ffmpeg", "-loglevel", "error", "-y",
         "-f", "rawvideo", "-pix_fmt", "rgb24", "-s", f"{w}x{h}",
         "-r", str(SIM_FPS // step), "-i", "-",
         "-filter_complex",
         "split[a][b];[a]palettegen=stats_mode=diff[p];"
         "[b][p]paletteuse=dither=bayer:bayer_scale=5",
         "-loop", "0", out],
        stdin=subprocess.PIPE)

    for i in range(int(seconds * SIM_FPS)):
        plugin.render(screen, dt)
        if i % step == 0:
            ffmpeg.stdin.write(pygame.image.tobytes(screen, "RGB"))

    ffmpeg.stdin.close()
    if ffmpeg.wait() != 0:
        sys.exit(f"ffmpeg failed for {plugin_name}")
    plugin.shutdown()
    print(f"{out}: {os.path.getsize(out) / 1e6:.1f} MB")


def main():
    ap = argparse.ArgumentParser(
        description="Render x11saver plugins off-screen and save looping GIFs.")
    ap.add_argument("plugin", nargs="?", help="plugin to capture")
    ap.add_argument("-o", "--output", help="output file (default: <plugin>.gif)")
    ap.add_argument("--seconds", type=float, default=5.0, help="length (default: 5)")
    ap.add_argument("--size", default="800x450", help="WIDTHxHEIGHT (default: 800x450)")
    ap.add_argument("--fps", type=int, default=20, help="GIF frame rate (default: 20)")
    ap.add_argument("--warmup", type=float, default=2.0,
                    help="seconds to simulate before recording (default: 2)")
    ap.add_argument("--demos", nargs="?", const=os.path.join(REPO, "docs", "demos"),
                    metavar="DIR",
                    help="regenerate every README demo (default DIR: docs/demos)")
    args = ap.parse_args()

    if not shutil.which("ffmpeg"):
        sys.exit("capture: ffmpeg is required but was not found on PATH")
    if bool(args.plugin) == bool(args.demos):
        ap.error("give a plugin name or --demos, but not both")

    pygame.init()
    if args.demos:
        os.makedirs(args.demos, exist_ok=True)
        for name, settings in DEMOS.items():
            capture(name, os.path.join(args.demos, f"{name}.gif"), **settings)
    else:
        capture(args.plugin, args.output or f"{args.plugin}.gif", size=args.size,
                seconds=args.seconds, fps=args.fps, warmup=args.warmup)


if __name__ == "__main__":
    main()
